# Скопируйте в .env и заполните. Файл .env не попадает в git.

# --- Decision-модель: jev | kev | heuristic ---
DECISION_PROVIDER=heuristic
TYPESAFE_API_KEY=
# Для локального Kev (python -m kev.serve ... --port 8009):
KEV_BASE_URL=http://127.0.0.1:8009

# --- LLM для русских текстов: gigachat | yandexgpt | openai | none ---
LLM_PROVIDER=none
# GigaChat: ключ авторизации из личного кабинета developers.sber.ru
GIGACHAT_AUTH_KEY=
GIGACHAT_MODEL=GigaChat-2
# YandexGPT
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# gpt-4.1 / gpt-5.6-luna или Qwen3 через OpenAI-совместимый API
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1

# --- Источники (необязательно, повышают лимиты) ---
OPENALEX_API_KEY=
OPENALEX_EMAIL=
GITHUB_TOKEN=
# Semantic Scholar (необязательно): без ключа источник не используется
S2_API_KEY=
# Дополнительные источники (Crossref, КиберЛенинка, Europe PMC, новости на китайском); false — максимальная скорость
EXTRA_SOURCES=true
# Если задать — запуск поиска и оценки аналитика требуют заголовок X-API-Token (чтение открыто)
API_TOKEN=

# --- Развёртывание ---
POSTGRES_PASSWORD=change-me
HTTP_PORT=80
# Если registry.npmjs.org недоступен с сервера: https://registry.npmmirror.com/
NPM_REGISTRY=
