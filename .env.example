# Скопируйте в .env и заполните. Файл .env не попадает в git.

# --- Decision-модель: jev | kev | heuristic ---
DECISION_PROVIDER=heuristic
TYPESAFE_API_KEY=
# Для локального Kev (python -m kev.serve ... --port 8009):
KEV_BASE_URL=http://127.0.0.1:8009

# --- LLM для русских текстов: gigachat | yandexgpt | openai | none ---
LLM_PROVIDER=none
# GigaChat: ключ авторизации из личного кабинета developers.sber.ru
GIGACHAT_AUTH_KEY=
GIGACHAT_MODEL=GigaChat-2
# YandexGPT
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# gpt-4.1 / gpt-5.6-luna или Qwen3 через OpenAI-совместимый API.
# Закрытый контур (локальный Qwen3 в Ollama, профиль offline в docker-compose):
#   LLM_PROVIDER=openai  OPENAI_BASE_URL=http://ollama:11434/v1  OPENAI_API_KEY=local  OPENAI_MODEL=qwen3:8b
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1

# --- Источники (необязательно, повышают лимиты) ---
OPENALEX_API_KEY=
OPENALEX_EMAIL=
GITHUB_TOKEN=
# Semantic Scholar (необязательно): без ключа источник не используется
S2_API_KEY=
# Патенты (в т.ч. Китай) через EPO OPS: бесплатная регистрация на https://developers.epo.org; без ключа источник выключен
EPO_OPS_KEY=
EPO_OPS_SECRET=
# Дополнительные источники (Crossref, КиберЛенинка, Europe PMC, новости на китайском); false — максимальная скорость
EXTRA_SOURCES=true
# Если задать — запуск поиска и оценки аналитика требуют заголовок X-API-Token (чтение открыто)
API_TOKEN=

# --- Скорость и нагрузка ---
# Одновременно обрабатываемых запросов (остальные ждут в очереди)
MAX_PARALLEL_RUNS=2
# Повтор той же темы в течение N часов открывает готовый результат сразу (0 — всегда пересчитывать)
REUSE_HOURS=24
# Предрасчёт: сервер сам обновляет темы раз в N часов (0 — выключено). Пусто — 6 областей датасета; свои темы через «;»
PRECOMPUTE_EVERY_HOURS=0
PRECOMPUTE_QUERIES=
# Параллельных запросов к GigaChat: 1 — бесплатный тариф, 4–8 — корпоративный
GIGACHAT_CONCURRENCY=1

# --- Экономика (стоимость запроса в рублях) ---
# Пусто — ориентировочный тариф модели (GigaChat-2 0,2 ₽, Pro 1,5 ₽, Max 1,95 ₽ за 1000 токенов); локальная LLM — 0
LLM_RUB_PER_1K_TOKENS=
# Jev: цена одного вызова по договору с TypeSafe; Kev локально — 0
DECISION_RUB_PER_CALL=0

# --- Развёртывание ---
POSTGRES_PASSWORD=change-me
HTTP_PORT=80
# Если registry.npmjs.org недоступен с сервера: https://registry.npmmirror.com/
NPM_REGISTRY=

# Версия decision-модели Jev (закреплена: на её ответах обучен классификатор)
JEV_MODEL=jev-1.13.0

# Brave Search API (бесплатный ключ на api-dashboard.search.brave.com): события, патенты, закупки, доводы «против»
BRAVE_API_KEY=

# Источники 20.10: NCBI (PubMed), NASA ADS, Stack Exchange, Роспатент — ключи; SEC — User-Agent «Название почта»
NCBI_API_KEY=
NASA_ADS_TOKEN=
STACKEXCHANGE_KEY=
ROSPATENT_API_KEY=
# SEC: «Организация почта»; адреса на mail.ru SEC отклоняет (403). Пусто — SEC не запрашивается. Например: AgentsOfMoscow имя@gmail.com
SEC_USER_AGENT=
# Lens.org: патенты мира с названиями и заявителями (лестница «патент», карта игроков); 1000 запросов в месяц
LENS_API_TOKEN=

# Маршрутизация по странам (как раздельный VPN). Стенд за рубежом: российские госсайты — через прокси с российским адресом
# (deploy/ru-proxy-setup.sh на любом российском VPS), остальное напрямую. Упал прокси — запросы идут напрямую сами.
RU_PROXY_URL=
# RU_PROXY_HOSTS=zakupki.gov.ru,searchplatform.rospatent.gov.ru,cyberleninka.ru,habr.com,vc.ru,www.cnews.ru
# Если стенд в России — наоборот, зарубежные API через зарубежный прокси:
FOREIGN_PROXY_URL=
# FOREIGN_PROXY_HOSTS=efts.sec.gov,api.search.brave.com,api.lens.org,ops.epo.org,api.typesafe.ai,api.openalex.org

# Запасные ключи OpenAlex через запятую: когда квота основного кончается, система переходит на следующий
OPENALEX_API_KEY_BACKUP=
